---
import MainLayout from '../../layouts/MainLayout.astro';
---

<MainLayout title="Learning Path">
    <div class="max-w-4xl mx-auto py-12 px-6">
        
        <div class="mb-12">
            <h1 class="text-4xl font-bold text-slate-900 mb-4">Learning Path</h1>
            <p class="text-slate-600">Select a module to start hunting.</p>
        </div>

        <div class="grid gap-6 md:grid-cols-2">
            
            <a href="/learn/http-basics" class="block p-6 bg-white border border-slate-200 rounded-xl hover:border-blue-500 hover:shadow-lg transition-all">
                <div class="text-3xl mb-4">🌐</div>
                <h3 class="font-bold text-xl mb-2">1. HTTP Basics</h3>
                <p class="text-slate-500 text-sm">Understanding requests & responses.</p>
                <div class="mt-2 text-xs font-bold text-green-600">Available Now</div>
            </a>

            <a href="/learn/recon" class="block p-6 bg-white border border-slate-200 rounded-xl hover:border-purple-500 hover:shadow-lg transition-all">
                <div class="text-3xl mb-4">🔍</div>
                <h3 class="font-bold text-xl mb-2">2. Reconnaissance</h3>
                <p class="text-slate-500 text-sm">Subdomain enum & Google Dorks.</p>
                <div class="mt-2 text-xs font-bold text-green-600">Available Now</div>
            </a>

        </div>
    </div>
</MainLayout>