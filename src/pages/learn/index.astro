---
import MainLayout from '../../layouts/MainLayout.astro';
---

<MainLayout title="Learning Path">
    <div class="max-w-3xl mx-auto py-12">
        <h1 class="text-4xl font-extrabold text-slate-900 mb-8">Learning Path</h1>
        
        <div class="grid gap-4">
            <a href="/learn/http-basics" class="block p-6 bg-white border border-slate-200 rounded-lg hover:border-blue-500 hover:shadow-md transition">
                <h3 class="font-bold text-lg text-slate-800">1. HTTP Protocols & Request Cycles</h3>
                <p class="text-slate-500 text-sm mt-1">Understanding raw HTTP requests, headers, and status codes.</p>
            </a>
            
            <div class="block p-6 bg-slate-50 border border-slate-200 rounded-lg opacity-60">
                <h3 class="font-bold text-lg text-slate-800">2. Reconnaissance (Coming Soon)</h3>
            </div>
        </div>
    </div>
</MainLayout>