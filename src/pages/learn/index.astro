---
import MainLayout from '../../layouts/MainLayout.astro';
---

<MainLayout title="Learning Path">
    <div class="max-w-4xl mx-auto py-12 px-6">
        
        <div class="mb-12 text-center md:text-left">
            <h1 class="text-4xl font-extrabold text-slate-900 mb-4">
                Learning <span class="text-blue-600">Path</span>
            </h1>
            <p class="text-lg text-slate-600 max-w-2xl">
                Master vulnerability research step-by-step. From understanding the protocol to exploiting complex logic.
            </p>
        </div>

        <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
            
            <a href="/learn/http-basics" class="group relative block p-6 bg-white border border-slate-200 rounded-2xl hover:border-blue-500 hover:shadow-xl hover:-translate-y-1 transition-all duration-300">
                <div class="w-12 h-12 bg-blue-100 rounded-lg flex items-center justify-center mb-4 text-2xl group-hover:bg-blue-600 group-hover:text-white transition-colors">
                    🌐
                </div>
                <h3 class="font-bold text-xl text-slate-900 mb-2 group-hover:text-blue-600 transition-colors">
                    1. HTTP Basics
                </h3>
                <p class="text-slate-500 text-sm leading-relaxed">
                    Understanding raw HTTP requests, headers, methods (GET/POST), and status codes.
                </p>
                <div class="mt-4 flex items-center text-xs font-medium text-green-600">
                    <span class="w-2 h-2 bg-green-500 rounded-full mr-2 animate-pulse"></span>
                    Available Now
                </div>
            </a>

            <div class="relative block p-6 bg-slate-50 border border-slate-200 rounded-2xl opacity-75 grayscale hover:grayscale-0 transition-all cursor-not-allowed">
                <div class="w-12 h-12 bg-slate-200 rounded-lg flex items-center justify-center mb-4 text-2xl">
                    🔍
                </div>
                <h3 class="font-bold text-xl text-slate-700 mb-2">
                    2. Reconnaissance
                </h3>
                <p class="text-slate-500 text-sm leading-relaxed">
                    Subdomain enumeration, asset discovery, and finding hidden endpoints.
                </p>
                <div class="mt-4 flex items-center text-xs font-medium text-slate-500">
                    <span class="w-2 h-2 bg-slate-400 rounded-full mr-2"></span>
                    Coming Soon
                </div>
            </div>

            <div class="relative block p-6 bg-slate-50 border border-slate-200 rounded-2xl opacity-75 grayscale hover:grayscale-0 transition-all cursor-not-allowed">
                <div class="w-12 h-12 bg-slate-200 rounded-lg flex items-center justify-center mb-4 text-2xl">
                    🔓
                </div>
                <h3 class="font-bold text-xl text-slate-700 mb-2">
                    3. IDOR
                </h3>
                <p class="text-slate-500 text-sm leading-relaxed">
                    Insecure Direct Object References. Accessing data you shouldn't see.
                </p>
                <div class="mt-4 flex items-center text-xs font-medium text-slate-500">
                    <span class="w-2 h-2 bg-slate-400 rounded-full mr-2"></span>
                    Coming Soon
                </div>
            </div>

        </div>
    </div>
</MainLayout>