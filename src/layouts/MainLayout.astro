---
// 1. Import CSS Style di sini (DI DALAM PAGAR)
import "../styles/global.css";

// 2. Definisi Tipe Data
interface Props {
	title: string;
}

// 3. Ambil data title
const { title } = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Bug Hunting Portfolio" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{title} | BugHunter101</title>
	</head>
	<body class="bg-white text-slate-900 font-sans antialiased">
		
		<nav class="fixed w-full z-50 top-0 start-0 border-b border-gray-200 bg-white/80 backdrop-blur-md">
			<div class="max-w-screen-xl flex flex-wrap items-center justify-between mx-auto p-4">
				<a href="/" class="flex items-center space-x-3 rtl:space-x-reverse">
					<span class="self-center text-2xl font-extrabold whitespace-nowrap tracking-tight">
                        BugHunter<span class="text-blue-600">101</span>
                    </span>
				</a>
                <div class="space-x-4">
                    <a href="/learn" class="text-slate-600 hover:text-blue-600 font-medium">Start Learning</a>
                </div>
			</div>
		</nav>

		<main class="pt-24 min-h-screen max-w-screen-xl mx-auto px-4">
			<slot />
		</main>

	</body>
</html>